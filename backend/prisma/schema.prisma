// Fyphost — Database schema (v3, persistence rebuild)
//
// Conventions:
//
// - Identifiers are short prefixed strings (med_, var_, sav_, ...).
// - Source-URL deduplication via Media.sourceHash. One Media per source.
// - The `Media` row is the root of permanent storage. All bytes for every
//   quality of that media live under Media.storageKey.
// - `MediaVariant` is one quality of one media. Its file paths are stored as
//   relative keys under Media.storageKey so the whole tree can be moved or
//   re-rooted without rewriting paths in the DB.
// - `SavedMedia` is the per-user claim on a Media. `SavedVariant` rows
//   record which qualities each user wants saved.
// - `MediaVariant.state` + `pipelineStep` + progress columns are the canonical
//   source of truth for "is this variant playable from local storage yet?".
// - Saved-media playback routes derive everything from the DB + permanent
//   storage; they NEVER touch upstream URLs. Only EPHEMERAL/CACHED flows do.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users + auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserKind {
  ANON
  REGISTERED
}

enum UserRole {
  USER
  ADMIN
}

enum EmailTokenKind {
  VERIFY
  RESET
}

model User {
  id                String     @id
  kind              UserKind   @default(ANON)
  role              UserRole   @default(USER)
  email             String?    @unique
  emailVerifiedAt   DateTime?
  displayName       String?
  passwordHash      String?
  storageQuotaBytes BigInt     @default(5368709120) // 5 GiB default
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastSeenAt        DateTime?

  saved         SavedMedia[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  sessions      StreamSession[]

  @@index([lastSeenAt])
}

model EmailToken {
  id        String         @id
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model RefreshToken {
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  rotatedFromId String?

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media + variants (root of permanent storage)
// ─────────────────────────────────────────────────────────────────────────────

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
  OTHER
}

/// State machine for a MediaVariant's bytes location.
/// Transitions are owned by save.worker.ts — see documentation there.
enum VariantState {
  EPHEMERAL          /// no bytes anywhere; only upstream URL known
  CACHED             /// transient hot bytes on NVMe cache
  PENDING            /// scheduled for permanent download
  FETCHING           /// resolving upstream playlist / file URL
  DOWNLOADING        /// actively writing bytes to staging
  GENERATING_HLS     /// finalizing local playlist
  GENERATING_THUMBNAIL
  FINALIZING         /// staged → permanent atomic move + verification
  PERSISTED          /// fully on permanent storage; never auto-evicted
  FAILED             /// terminal failure; safe to retry by re-enqueuing
  PENDING_DELETE     /// no SavedMedia references; queued for storage cleanup
}

enum VariantContainer {
  HLS
  MP4
  OTHER
}

model Media {
  id                  String     @id
  sourceHash          String     @unique // sha256(normalized source URL)
  sourceUrl           String
  name                String
  kind                MediaKind  @default(VIDEO)

  /// Top-level metadata shared across qualities.
  sizeBytes           BigInt?    // total of all variant bytes when persisted
  durationSec         Int?
  thumbnailUrl        String?    // fallback upstream thumbnail (used until we persist our own)

  /// Permanent storage layout (under env.STORAGE_PERMANENT_DIR):
  ///   {storageKey}/                  e.g. media/{mediaId}/
  ///     metadata.json                metadataKey
  ///     thumb.jpg                    thumbnailKey
  ///     poster.jpg                   posterKey
  ///     original/file.mp4            originalKey   (optional)
  ///     hls/master.m3u8              masterPlaylistKey
  ///     hls/{quality}/playlist.m3u8  per MediaVariant.hlsPlaylistKey
  ///     hls/{quality}/seg-N.ts       per MediaVariant.hlsSegmentDir
  storageKey          String?
  metadataKey         String?
  thumbnailKey        String?
  posterKey           String?
  originalKey         String?
  masterPlaylistKey   String?

  metadataRefreshedAt DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  variants            MediaVariant[]
  savedBy             SavedMedia[]

  @@index([createdAt])
}

model MediaVariant {
  id        String           @id
  mediaId   String
  media     Media            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  quality    String           // "240p" | "360p" | "480p" | "720p" | "1080p" | ...
  container  VariantContainer @default(HLS)
  width      Int?
  height     Int?
  bitrateBps Int?
  sizeBytes  BigInt?
  sha256     String?

  /// Upstream URLs (refreshable, may expire). Used only while EPHEMERAL/CACHED.
  upstreamPlaylistUrl String?
  upstreamFileUrl     String?
  upstreamRefreshedAt DateTime @default(now())

  /// Local storage. Paths are RELATIVE to Media.storageKey so the tree is
  /// movable. Either hlsPlaylistKey (HLS variant) or fileKey (MP4 variant)
  /// is set when state == PERSISTED.
  hlsPlaylistKey String?     // e.g. "hls/720p/playlist.m3u8"
  hlsSegmentDir  String?     // e.g. "hls/720p"
  fileKey        String?     // e.g. "files/720p.mp4"
  segmentCount   Int?

  /// State machine. Workers are the only writers of these columns.
  state          VariantState @default(EPHEMERAL)
  pipelineStep   String?      // free-text: "fetching playlist", "writing seg 12/40", ...
  progress       Float        @default(0) // 0..1
  bytesDone      BigInt       @default(0)
  bytesTotal     BigInt?
  speedBytesPerSec Int?
  etaSec         Int?
  errorMessage   String?
  attemptCount   Int          @default(0)

  /// Hot cache footprint, separate from PERSISTED (which lives on permanent disk).
  cachedBytes    BigInt       @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  savedVariants  SavedVariant[]
  cacheEntries   CacheEntry[]

  @@unique([mediaId, quality])
  @@index([state])
  @@index([upstreamRefreshedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User library (saved claims)
// ─────────────────────────────────────────────────────────────────────────────

/// Aggregated state for a SavedMedia. The save.service derives this from
/// the underlying SavedVariant rows + their MediaVariant.state.
enum SavedState {
  PENDING       // no variants yet finished
  IN_PROGRESS   // at least one variant still working
  COMPLETE      // all claimed variants PERSISTED
  PARTIAL       // some variants PERSISTED, at least one FAILED, none in flight
  FAILED        // all claimed variants FAILED
}

model SavedMedia {
  id          String     @id
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  state       SavedState @default(PENDING)
  /// The ONE quality the user selected for download. Only this quality's
  /// source file is served from the download endpoint.
  canonicalQuality String?
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  variants    SavedVariant[]
  shareTokens ShareToken[]

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([state])
}

model SavedVariant {
  id            String       @id
  savedMediaId  String
  saved         SavedMedia   @relation(fields: [savedMediaId], references: [id], onDelete: Cascade)
  mediaVariantId String
  variant       MediaVariant @relation(fields: [mediaVariantId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  /// jobId of the most recent BullMQ save attempt (optional, audit only).
  lastJobId     String?

  @@unique([savedMediaId, mediaVariantId])
  @@index([mediaVariantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cache entries (NVMe hot cache; separate from permanent storage)
// ─────────────────────────────────────────────────────────────────────────────

enum CacheKind {
  HLS_PLAYLIST
  HLS_SEGMENT
  FILE
}

model CacheEntry {
  id              String       @id
  mediaVariantId  String
  variant         MediaVariant @relation(fields: [mediaVariantId], references: [id], onDelete: Cascade)

  kind            CacheKind
  segmentKey      String       // "playlist" | "seg-<n>" | "file"
  storageKey      String
  bytes           BigInt
  contentType     String?

  createdAt       DateTime     @default(now())
  lastAccessedAt  DateTime     @default(now())

  @@unique([mediaVariantId, segmentKey])
  @@index([lastAccessedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stream sessions (audit + revocation)
// ─────────────────────────────────────────────────────────────────────────────

model StreamSession {
  id             String    @id
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  mediaVariantId String
  ip             String?
  userAgent      String?
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([mediaVariantId, expiresAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Queue audit
// ─────────────────────────────────────────────────────────────────────────────

enum QueueJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  RETRYING
}

model QueueJob {
  id          String         @id
  queue       String
  type        String
  payloadJson String
  status      QueueJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([queue, status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Share tokens (permanent public sharing)
// ─────────────────────────────────────────────────────────────────────────────

model ShareToken {
  id           String     @id
  savedMediaId String
  saved        SavedMedia @relation(fields: [savedMediaId], references: [id], onDelete: Cascade)
  /// Unique opaque token used in public URL: /share/{token}
  token        String     @unique
  /// Optional: restrict to specific quality for the share link
  quality      String?
  /// Allow disabling shares without deletion
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?
  accessCount  Int        @default(0)

  @@index([savedMediaId])
  @@index([token])
}
