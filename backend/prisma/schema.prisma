// Fyphost — Database schema
//
// Conventions:
// - Identifiers are short prefixed strings (med_, var_, sav_, sht_) generated app-side.
// - Source URL deduplication via Media.sourceHash.
// - MediaVariant.state is the bytes-location state machine for the HLS *streaming*
//   derivative of a quality.
// - The canonical *download* artifact is the ORIGINAL source.mp4, persisted on the
//   Media record itself (Media.sourceStorageKey). Variants are streaming derivatives,
//   not download artifacts. This separation is the architectural fix for the
//   "downloads serve playlist.m3u8" defect.
// - SavedMedia is the per-user library claim. There is exactly ONE SavedMedia row
//   per (userId, mediaId). The user's selectedQuality controls which HLS variant is
//   pinned for playback; the download is always the canonical source.
// - ShareToken is an opaque, permanent share link. Tokens are decoupled from
//   signed URLs: the share endpoint mints fresh signed playback URLs on every read,
//   so the token never expires while the saved media exists.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────────

enum UserKind {
  ANON
  REGISTERED
}

model User {
  id           String    @id
  kind         UserKind  @default(ANON)
  email        String?   @unique
  displayName  String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?

  saved    SavedMedia[]
  sessions StreamSession[]

  @@index([lastSeenAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media + Variants
// ─────────────────────────────────────────────────────────────────────────────

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
  OTHER
}

enum VariantState {
  EPHEMERAL      // not on disk; proxy-only
  CACHED         // on local NVMe cache
  PERSISTED      // HLS derivative copied into permanent storage
  PENDING_DELETE // marked for storage-cleanup worker
}

enum VariantContainer {
  HLS
  MP4
  OTHER
}

model Media {
  id           String    @id
  sourceHash   String    @unique // sha256(normalized source URL)
  sourceUrl    String             // original URL, for refresh
  name         String              // display name (mutable later)
  // Original filename as reported by the upstream extractor. Immutable. Used
  // verbatim for Content-Disposition on /download. Includes extension.
  originalFilename String?
  kind         MediaKind @default(VIDEO)
  sizeBytes    BigInt?            // sum of canonical variant or upstream-reported
  thumbnailUrl String?
  durationSec  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // last successful re-extract; URLs older than X are refreshed on demand
  metadataRefreshedAt DateTime @default(now())

  // ── Canonical source (download artifact) ────────────────────────────────────
  // The original MP4 (or other container) downloaded from the upstream
  // extractor's `download` URL. This is the ONLY file served by /download.
  // Persisted once per Media (deduplicated across users); never per-quality.
  sourceStorageKey      String?  // e.g. "media/<mediaId>/source.mp4"
  sourceSizeBytes       BigInt?
  sourceSha256          String?
  sourceContentType     String?  // e.g. "video/mp4"
  sourcePersistedAt     DateTime?
  sourcePendingDeleteAt DateTime? // set when last SavedMedia is removed; cleared if a save reappears

  variants MediaVariant[]
  saved    SavedMedia[]

  @@index([createdAt])
  @@index([sourcePendingDeleteAt])
}

model MediaVariant {
  id      String @id
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  quality    String // "360p" | "480p" | "720p" | "1080p" | "audio"
  container  VariantContainer @default(HLS)
  width      Int?
  height     Int?
  bitrateBps Int?
  sizeBytes  BigInt?

  // Upstream URLs (refreshable, may expire)
  upstreamPlaylistUrl String? // m3u8
  upstreamFileUrl     String? // direct mp4/etc
  upstreamRefreshedAt DateTime @default(now())

  // Bytes-location state for the HLS streaming derivative.
  // NOTE: PERSISTED here means the *HLS playlist + segments* are persisted at
  // `storageKey`. It is NOT the canonical download artifact. Downloads always
  // serve Media.sourceStorageKey.
  state       VariantState @default(EPHEMERAL)
  storageKey  String?      // canonical layout: "media/<mediaId>/hls/<quality>"
  sha256      String?      // sha256 of the rewritten playlist (or first segment) — verification only
  cachedBytes BigInt       @default(0) // current cache footprint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saved        SavedMedia[] @relation("SelectedVariant")
  cacheEntries CacheEntry[]

  @@unique([mediaId, quality])
  @@index([state])
  @@index([upstreamRefreshedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved (user library) — ONE row per (userId, mediaId).
// ─────────────────────────────────────────────────────────────────────────────

enum SavedState {
  PENDING
  DOWNLOADING
  COMPLETE
  FAILED
}

model SavedMedia {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The Media this save belongs to. One save per (userId, mediaId).
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  // The user's chosen streaming quality label, e.g. "720p". The download
  // artifact is always the Media.sourceStorageKey original — quality only
  // controls which HLS variant is pinned for playback.
  selectedQuality String

  // FK to the variant matching `selectedQuality`. Re-save with a different
  // quality updates this row (no row duplication, no storage explosion).
  selectedVariantId String?
  selectedVariant   MediaVariant? @relation("SelectedVariant", fields: [selectedVariantId], references: [id], onDelete: SetNull)

  state       SavedState @default(PENDING)
  progress    Float      @default(0) // 0..1
  jobId       String?    // BullMQ job id
  error       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  shareToken ShareToken?

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([state])
  @@index([selectedVariantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Permanent share tokens — opaque, never expire while SavedMedia exists.
// ─────────────────────────────────────────────────────────────────────────────

model ShareToken {
  token        String     @id // opaque url-safe id; `sht_<26 chars>`
  savedMediaId String     @unique
  savedMedia   SavedMedia @relation(fields: [savedMediaId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?
  // Soft analytics, not used for auth.
  lastViewedAt DateTime?
  viewCount    Int        @default(0)

  @@index([savedMediaId])
  @@index([revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cache entries (NVMe hot cache)
// ─────────────────────────────────────────────────────────────────────────────

enum CacheKind {
  HLS_PLAYLIST
  HLS_SEGMENT
  FILE
}

model CacheEntry {
  id             String       @id
  mediaVariantId String
  variant        MediaVariant @relation(fields: [mediaVariantId], references: [id], onDelete: Cascade)

  kind        CacheKind
  segmentKey  String  // "playlist" | "seg-<n>" | "file"
  storageKey  String  // path under storage/cache/...
  bytes       BigInt
  contentType String?

  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@unique([mediaVariantId, segmentKey])
  @@index([lastAccessedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stream sessions (audit + revocation)
// ─────────────────────────────────────────────────────────────────────────────

model StreamSession {
  id             String    @id
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  mediaVariantId String
  ip             String?
  userAgent      String?
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([mediaVariantId, expiresAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Queue audit
// ─────────────────────────────────────────────────────────────────────────────

enum QueueJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  RETRYING
}

model QueueJob {
  id          String         @id // BullMQ job id
  queue       String
  type        String
  payloadJson String
  status      QueueJobStatus @default(QUEUED)
  attempts    Int            @default(0)
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([queue, status])
  @@index([createdAt])
}
