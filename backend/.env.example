NODE_ENV=development
LOG_LEVEL=info

# API
HOST=0.0.0.0
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://fyphost:fyphost@localhost:5432/fyphost?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth / signing
JWT_SECRET=change-me-jwt-please
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
PASSWORD_MIN_LENGTH=8
EMAIL_TOKEN_TTL_SEC=86400
SIGNING_SECRET=change-me-signing-secret
SIGNING_KEY_VERSION=v1
SIGNED_URL_TTL_SEC=21600
COOKIE_SECURE=auto
COOKIE_DOMAIN=

# SMTP (Nodemailer). Leave SMTP_HOST empty in dev to log emails to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fyphost <no-reply@fyphost.local>
SMTP_SECURE=false

# Storage
STORAGE_BACKEND=local
STORAGE_CACHE_DIR=./storage/cache
STORAGE_PERMANENT_DIR=./storage/permanent
CACHE_HIGH_WATERMARK_BYTES=53687091200
CACHE_LOW_WATERMARK_BYTES=42949672960

# Upstream extractor
TERABOX_EXTRACTOR_URL=https://throbbing-disk-7a68.ftcweb.workers.dev

# CORS — comma-separated list of origins (or "*")
CORS_ORIGIN=http://localhost:3000
